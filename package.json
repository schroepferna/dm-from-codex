{
  "name": "nda-download-manager",
  "version": "0.1.0",
  "description": "Cross-platform NDA package download manager.",
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "ng build",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build:electron && concurrently --kill-others-on-fail \"ng serve --host 127.0.0.1 --port 4200\" \"wait-on http://127.0.0.1:4200 && electron .\"",
    "start:stage": "npm run build:electron && concurrently --kill-others-on-fail \"ng serve --host 127.0.0.1 --port 4200 --configuration stage\" \"wait-on http://127.0.0.1:4200 && electron .\"",
    "start:revengers": "npm run build:electron && concurrently --kill-others-on-fail \"ng serve --host 127.0.0.1 --port 4200 --configuration revengers\" \"wait-on http://127.0.0.1:4200 && electron .\"",
    "electron": "npm run build:electron && electron .",
    "package": "npm run build && electron-builder",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@smithy/node-http-handler": "^4.0.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.0.0",
    "typescript": "~5.9.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "gov.nih.nda.downloadmanager",
    "productName": "NDA Download Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "ndaicon.ico",
      "package.json"
    ],
    "icon": "ndaicon.ico",
    "protocols": [
      {
        "name": "NDA Download Manager",
        "schemes": [
          "nda-dm"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis",
      "icon": "ndaicon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
